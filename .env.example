# ============================================================
# FX Engine — environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER log these values (§17.7 — secrets handling).
# ============================================================

# ----- OANDA fxTrade Practice (M6 paper trading) ----------
OANDA_ACCOUNT_ID=your-account-id-here
OANDA_API_TOKEN=your-api-token-here
OANDA_ENVIRONMENT=practice          # or "live" at M7

# ----- News / economic calendar (trading-news-pipeline) ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=
NEWSDATA_API_KEY=

# ----- Logging --------------------------------------------
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                        # Relative path; leave blank for stdout only

# ----- Data store -----------------------------------------
DATA_DIR=data/raw                   # Immutable raw tick store root (M1)
